# IELTS PEEL Hacker — server environment (optional)
#
# Copy to `.env` and adjust. The server already reads these via process.env.
# NOTE: by default the browser sends the user's own API key per request.
# For shared/production deployment, see README "安全" — inject a server-side
# key and add auth instead of accepting arbitrary client keys.

# Port the Express API listens on (default: 3001)
PORT=3001

# Optional: a server-side default base URL / model if you lock the deployment
# to one provider. Leave blank to let each client choose.
# DEFAULT_BASE_URL=https://api.openai.com/v1
# DEFAULT_MODEL=gpt-4o-mini
