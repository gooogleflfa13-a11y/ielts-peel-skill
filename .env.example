# IELTS PEEL Hacker server configuration
# Public mode is stateless and requires an explicit CORS allowlist.

# Port the Express API listens on (default: 3001)
PORT=3001

# local | public
APP_MODE=local

# Provider selection is server-owned and never accepted from browser requests.
PROVIDER_BASE_URL=https://api.openai.com/v1
UPSTREAM_TIMEOUT_MS=30000
DEFAULT_MODEL=gpt-4o-mini

# Required as a comma-separated allowlist in public mode.
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0

# Public mode always disables local memory and the private question bank.
ENABLE_LOCAL_MEMORY=false
ENABLE_PRIVATE_QUESTION_BANK=false

# Metrics remain unavailable when this is blank.
METRICS_TOKEN=
